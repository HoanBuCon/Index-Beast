{
  "name": "index-beast-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=../.env --watch src/index.ts",
    "deploy-commands": "node --env-file=../.env src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
