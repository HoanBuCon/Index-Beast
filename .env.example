# Cấu hình Index Beast. Sao chép thành `.env` ở gốc repo rồi điền giá trị. KHÔNG commit file `.env`.
#
# Quy ước:
# - Chỉ có MỘT file .env, đặt ở gốc repo (backend, bot, docker compose đều đọc file này).
# - Chú thích đặt trên dòng riêng. KHÔNG viết `KEY=giá-trị  # chú thích`: docker compose sẽ hiểu
#   phần chú thích là giá trị khi giá trị để trống.
# - Dev local dùng 127.0.0.1 (không dùng localhost: Windows thử IPv6 trước nên bị timeout).
# - Không dùng cổng mặc định của công cụ: cổng dự án = cổng gốc + 10000 (docs/quy_uoc.md → "Quy ước cổng").
#   Mỗi cổng chỉ khai báo ở MỘT biến *_PORT; docker compose, backend, web, bot cùng đọc.
# - Trong Docker, địa chỉ PostgreSQL/Qdrant/Redis do docker-compose.yml đặt, bỏ qua giá trị ở đây.
# - Thêm biến mới: xem README → "Cấu hình".

# ---------- Chung ----------
# dev | test | prod. Ở chế độ prod, ứng dụng từ chối khởi động nếu còn giá trị "change-me".
ENVIRONMENT=dev
# Các mức ghi log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
# Dùng chung cho container postgres và backend (backend tự ghép thành URL kết nối).
# POSTGRES_PORT: cổng mở trên máy (docker compose ánh xạ vào cổng 5432 trong container).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=indexbeast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=indexbeast

# ---------- Qdrant, Redis ----------
# Cổng mở trên máy; trong container lần lượt vẫn là 6333 / 6379.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=16333
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0

# Số giây chờ khi kết nối/đọc PostgreSQL, Qdrant, Redis; đồng thời là thời gian tối đa cho mỗi lần kiểm tra trạng thái.
CLIENT_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2

# ---------- API ----------
# Cổng API khi chạy trên máy (`make api`); web dùng proxy /api và bot ở chế độ phát triển cũng đọc biến này.
# Trong Docker, container api luôn lắng nghe ở cổng nội bộ 18000 — biến này không ảnh hưởng.
API_PORT=18000
# Nhiều origin, phân cách bằng dấu phẩy. Phải khớp với WEB_PORT.
CORS_ORIGINS=http://localhost:15173
# Số tiến trình worker uvicorn trong container api.
API_WORKERS=2

# ---------- Discord bot ----------
DISCORD_TOKEN=
# Không bắt buộc: để trống thì bot tự lấy mã ứng dụng từ Discord bằng DISCORD_TOKEN.
DISCORD_CLIENT_ID=
# Không bắt buộc, hiện chưa dùng: lệnh slash được đăng ký toàn cục cho mọi máy chủ đã cài bot.
DISCORD_GUILD_ID=
# Bot gửi token này trong header X-Service-Token; API dùng cùng giá trị để xác thực bot.
API_SERVICE_TOKEN=change-me
# Để trống: bot ở chế độ phát triển gọi http://127.0.0.1:<API_PORT>. Trong Docker, compose đặt http://api:18000.
BOT_API_URL=
# Liên kết "xem đầy đủ trên web" mà bot gửi kèm câu trả lời.
WEB_URL=http://localhost:15173

# ---------- Web ----------
# Cổng máy chủ phát triển Vite (`npm run dev`).
WEB_PORT=15173
# make web/make dev: 127.0.0.1 chỉ dùng trên máy này; dùng IP LAN/VPN hoặc 0.0.0.0 để chia sẻ web.
WEB_HOST=127.0.0.1

# ---------- Triển khai ----------
# Tên miền thật trên VPS để Caddy tự cấp HTTPS.
DOMAIN=localhost
# none: không ghi log container xuống đĩa · local: bật để gỡ lỗi (xoay vòng 5×20MB).
DOCKER_LOG_DRIVER=none

# ---------- DeepSeek Platform (TV3) ----------
# Lấy khóa từ DeepSeek Platform. Backend vẫn chạy endpoint kiểm tra trạng thái khi khóa để trống.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Chỉ áp dụng khi không bật suy luận mở rộng. Khi bật suy luận mở rộng, temperature không được áp dụng; không bảo đảm loại bỏ hoàn toàn câu trả lời bịa đặt.
LLM_TEMPERATURE=0.2
# Giới hạn gồm cả phần suy luận và đầu ra theo nhà cung cấp; giá trị 4096 đã được kiểm tra nhanh với RAG.
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------- Bảo vệ API (TV1): chỉ áp dụng khi CHAT_MODE=rag ----------
# Số câu hỏi mỗi phút cho mỗi IP (web) hoặc mỗi external_ref (bot có API_SERVICE_TOKEN hợp lệ).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GUILD_PER_MINUTE=30
# Thời hạn cho một câu hỏi qua JSON/Discord; giữ thấp hơn timeout 60 giây của bot.
CHAT_TIMEOUT_SECONDS=45
# Hạn cho cả lượt SSE của web (tính cả chờ token đầu); web không bị giới hạn 60 giây như bot.
CHAT_STREAM_TIMEOUT_SECONDS=90
# Ngân sách cho bước chuẩn bị (Agent + công cụ); thời gian còn lại dành cho sinh câu trả lời.
CHAT_PREPARE_TIMEOUT_SECONDS=25

# ---------- Chat/RAG (TV3) ----------
# Các chế độ: mock | rag. Không tự động chuyển chế độ dự phòng.
CHAT_MODE=mock
# Chế độ rag: một vòng lặp Agent (DeepSeek gọi tool) chuẩn bị mỗi lượt; Generator viết câu trả lời.
CHAT_CLARIFICATION_MAX_ROUNDS=3
# Hạn mỗi lượt gọi Agent và số lượt gọi mô hình tối đa của vòng lặp (web off/always). Đếm lượt gọi, không đếm số
# tool trong một lượt; lượt cuối chỉ cho finish. Bước viết có ngân sách riêng.
CHAT_AGENT_TIMEOUT_SECONDS=12
CHAT_AGENT_MAX_CALLS=6
# Web auto: ngân sách lượt gọi lớn hơn, cùng cách đếm.
CHAT_COVERAGE_MAX_CALLS=12
# postgres cần migration 0002 và thiết lập collection bộ nhớ riêng. RAM vẫn là mặc định tương thích với cách bật tùy chọn.
# Dùng 'postgres' thay cho 'memory' để lưu trữ bền vững sau khi hoàn tất thiết lập cần thiết ở trên.
CHAT_PERSISTENCE=memory
CHAT_MEMORY_COLLECTION=conversation_memories
CHAT_MEMORY_CANDIDATES=6
CHAT_MEMORY_TIMEOUT_SECONDS=5
# Ngân sách số lượt/ký tự bộ nhớ đưa cho Agent chọn; 0 tắt việc nhớ lại, không tắt yêu cầu làm rõ đang chờ.
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_CHARS=8000
RAG_COLLECTION=lore_chunks
# Chế độ pilot chấp nhận các tư liệu Elden Ring hợp lệ mà không tự giả định đã được duyệt.
# reviewed giữ nguyên chính sách trước đây: game gốc + nội dung đã được duyệt.
RAG_CORPUS_POLICY=pilot
RAG_LANGUAGES=en
RAG_PREFETCH=30
RAG_TOP_K=5
# Giới hạn ký tự cho ngữ cảnh tạo câu trả lời; khác với giới hạn tokenizer E5 khi lập chỉ mục.
RAG_CONTEXT_CHARS=12000
# Giao diện web chọn auto/always cho từng tin nhắn; Discord luôn dùng auto.
# Khi có khóa, tính năng tự khả dụng ở chế độ rag; false là công tắc khẩn cấp để người vận hành tắt tính năng.
# Điền key Tavily thật trong .env cục bộ; giữ trống ở file mẫu để không đưa secret lên Git.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODE=auto
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=3
# prefer ưu tiên tìm thêm ngoài danh sách. restrict giới hạn đúng trong các domain bên dưới.
WEB_SEARCH_DOMAINS_MODE=prefer
WEB_SEARCH_DOMAINS=eldenring.wiki.gg,eldenring.wiki.fextralife.com,en.bandainamcoent.eu
# Thời gian chờ tối đa cho mỗi lần truy xuất do Tool Agent gọi.
RAG_RETRIEVAL_TIMEOUT_SECONDS=20
# Jina Reranker API: https://api.jina.ai/v1/rerank
# Điền JINA_API_KEY trong .env cục bộ; để trống thì backend dùng NoReranker kể cả khi cờ bật.
JINA_API_KEY=
# Bật tích hợp reranker Jina; mặc định tắt.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=jina-reranker-v2-base-multilingual
RAG_RERANKER_TIMEOUT_SECONDS=3
RAG_RERANKER_MAX_CANDIDATES=30
# Cho phép thinking ở bước viết. true: chỉ nghĩ ở câu Agent khai báo needs_reasoning (nguồn mâu thuẫn, nhiều bước,
# so sánh nhiều tiêu chí); false: không bao giờ nghĩ. Lần sinh lại, Answer Guard, chọn ảnh luôn tắt.
RAG_THINKING_ENABLED=false
# Thử nghiệm: thinking cho các lượt Agent (tốn token và chậm hơn; lượt finish bắt buộc vẫn tắt).
CHAT_AGENT_THINKING=false
# Tạo thêm 0 hoặc 1 lần khi JSON lỗi, nội dung trống hoặc đầu ra bị đánh dấu thiếu thông tin nhưng vẫn có trích dẫn; lần khôi phục không bật suy luận mở rộng.
RAG_FORMAT_RETRIES=1
# Đường dẫn tương đối từ backend/; chỉ nạp model khi thực sự lập chỉ mục hoặc truy xuất.
RAG_MODELS_DIR=models/fastembed
RAG_BATCH_SIZE=32
RAG_ENCODER_THREADS=2
# Truy xuất ảnh được liên kết ở máy cục bộ; không tải ảnh hoặc lập chỉ mục lại. Đường dẫn tính từ backend/.
RAG_IMAGES_ENABLED=true
RAG_IMAGES_CATALOG=data/clean_runs/s2-full-v2/images.csv
RAG_IMAGES_DOCUMENTS=data/chunk_runs/s2-full-v1/documents.jsonl
RAG_IMAGES_ROOT=data/media/blobs
RAG_IMAGES_MANIFESTS=data/crawl_runs/s2-full-20261028/media
RAG_IMAGES_MAX_BYTES=20000000
RAG_IMAGES_MAX_PIXELS=40000000

# ---------- Đăng nhập Discord (ADR-005) ----------
# Tắt cho tới khi có đủ DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET và AUTH_SECRET.
# Client ID và secret lấy tại Discord Developer Portal → OAuth2; thêm URL callback vào mục Redirects.
DISCORD_CLIENT_SECRET=
# Khóa băm Discord ID, tạo bằng `openssl rand -hex 32`. Không đổi sau khi đã có người dùng.
AUTH_SECRET=
# Để trống thì dùng <WEB_URL>/api/v1/auth/discord/callback.
AUTH_REDIRECT_URI=
AUTH_SESSION_DAYS=7
# Để trống thì tự bật khi WEB_URL dùng https; đặt true hoặc false để ghi đè.
# AUTH_COOKIE_SECURE=true
# Discord ID của quản trị viên, phân cách bằng dấu phẩy. Quản trị viên đăng nhập vào được /admin mà không cần token.
AUTH_ADMIN_DISCORD_IDS=

# ---------- Trang quản trị ----------
# Token xem /admin/* (trace RAG). Bỏ trống hoặc change-me thì /admin/* tắt. Tạo: openssl rand -hex 32
# ADMIN_TOKEN=change-me

# ---------- Nhập dữ liệu ngoại tuyến (TV2) ----------
# Thông tin liên hệ được gửi trong User-Agent của crawler; bắt buộc với các lệnh truy cập mạng.
INGEST_CONTACT_EMAIL=
