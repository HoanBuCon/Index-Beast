# Cấu hình Index Beast. Sao chép thành `.env` ở gốc repo rồi điền giá trị. KHÔNG commit file `.env`.
#
# Quy ước:
# - Chỉ có MỘT file .env, đặt ở gốc repo (backend, bot, docker compose đều đọc file này).
# - Chú thích đặt trên dòng riêng. KHÔNG viết `KEY=giá-trị  # chú thích`: docker compose sẽ hiểu
#   phần chú thích là giá trị khi giá trị để trống.
# - Dev local dùng 127.0.0.1 (không dùng localhost: Windows thử IPv6 trước nên bị timeout).
# - Không dùng cổng mặc định của công cụ: cổng dự án = cổng gốc + 10000 (docs/quy_uoc.md → "Quy ước cổng").
#   Mỗi cổng chỉ khai báo ở MỘT biến *_PORT; docker compose, backend, web, bot cùng đọc.
# - Trong Docker, địa chỉ PostgreSQL/Qdrant/Redis do docker-compose.yml đặt, bỏ qua giá trị ở đây.
# - Thêm biến mới: xem README → "Cấu hình".

# ---------- Chung ----------
# dev | test | prod. prod: app từ chối khởi động nếu còn giá trị "change-me"
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
# Dùng chung cho container postgres và backend (backend tự ghép thành connection URL).
# POSTGRES_PORT: cổng mở trên máy (docker compose map vào 5432 trong container)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=indexbeast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=indexbeast

# ---------- Qdrant, Redis ----------
# Cổng mở trên máy; trong container vẫn là 6333 / 6379
QDRANT_HOST=127.0.0.1
QDRANT_PORT=16333
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0

# Giây chờ khi kết nối/đọc PostgreSQL, Qdrant, Redis; và tối đa cho mỗi health check
CLIENT_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2

# ---------- API ----------
# Cổng API khi chạy local (`make api`); web proxy /api và bot dev cũng đọc biến này.
# Trong Docker, container api luôn nghe 18000 nội bộ — biến này không ảnh hưởng.
API_PORT=18000
# Nhiều origin, phân cách bằng dấu phẩy. Phải khớp WEB_PORT
CORS_ORIGINS=http://localhost:15173
# Số worker uvicorn trong container api
API_WORKERS=2

# ---------- Discord bot ----------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Server Discord dùng khi dev: slash command được đăng ký ngay lập tức
DISCORD_GUILD_ID=
# Bot gửi token này trong header X-Service-Token; API dùng cùng giá trị để xác thực bot
API_SERVICE_TOKEN=change-me
# Bỏ trống: bot dev gọi http://127.0.0.1:<API_PORT>. Trong Docker, compose đặt http://api:18000
BOT_API_URL=
# Link "xem đầy đủ trên web" mà bot gửi kèm câu trả lời
WEB_URL=http://localhost:15173

# ---------- Web ----------
# Cổng Vite dev server (`npm run dev`)
WEB_PORT=15173
# make web/make dev: 127.0.0.1 chỉ local; IP LAN/VPN hoặc 0.0.0.0 để chia sẻ web.
WEB_HOST=127.0.0.1

# ---------- Triển khai ----------
# Tên miền thật trên VPS để Caddy tự cấp HTTPS
DOMAIN=localhost
# none: không ghi log container xuống đĩa · local: bật để debug (xoay vòng 5×20MB)
DOCKER_LOG_DRIVER=none

# ---------- DeepSeek Platform (TV3) ----------
# Key lấy từ DeepSeek Platform. Backend vẫn chạy health endpoint khi key để trống.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Chỉ áp dụng non-thinking. Thinking bỏ qua temperature; không bảo đảm hết ảo giác.
LLM_TEMPERATURE=0.2
# Budget gồm cả reasoning/output theo provider; 4096 đã được smoke test RAG.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------- Bảo vệ API (TV1): chỉ áp dụng khi CHAT_MODE=llm_only hoặc rag ----------
# Số câu hỏi mỗi phút cho mỗi IP (web) hoặc mỗi external_ref (bot có API_SERVICE_TOKEN hợp lệ)
RATE_LIMIT_PER_MINUTE=10
# Hạn cho một câu hỏi; giữ nhỏ hơn timeout 60 giây của bot
CHAT_TIMEOUT_SECONDS=45

# ---------- Chat/RAG (TV3) ----------
# mock | llm_only | rag. Không tự fallback giữa các chế độ.
CHAT_MODE=mock
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_CHARS=8000
RAG_COLLECTION=lore_chunks
# Pilot admits valid Elden Ring artifacts without inventing review approval.
# reviewed retains the previous base + approved policy.
RAG_CORPUS_POLICY=pilot
RAG_LANGUAGES=en
RAG_PREFETCH=30
RAG_TOP_K=5
# Budget ký tự cho context generation; khác budget tokenizer E5 lúc index.
RAG_CONTEXT_CHARS=12000
RAG_REWRITE_ENABLED=false
# Broad VI/EN questions: metadata preference and at most two retrieval queries; no extra LLM for routing.
RAG_OVERVIEW_ENABLED=true
# When rewrite is enabled: rewrite = one query; dual = English + original (at most two).
RAG_QUERY_MODE=rewrite
RAG_REWRITE_TIMEOUT_SECONDS=8
RAG_REWRITE_MAX_TOKENS=512
# Total await budget for retrieval; split evenly across planned queries.
RAG_RETRIEVAL_TIMEOUT_SECONDS=20
RAG_THINKING_ENABLED=false
# 0 or 1 extra generation for JSON/blank/insufficient-with-citations errors; recovery uses non-thinking.
RAG_FORMAT_RETRIES=1
# Đường dẫn tương đối từ backend/; model chỉ load khi index/retrieve thật.
RAG_MODELS_DIR=models/fastembed
RAG_BATCH_SIZE=32
RAG_ENCODER_THREADS=2
# Local linked-image retrieval; no image downloads or reindex. Paths relative to backend/.
RAG_IMAGES_ENABLED=true
RAG_IMAGES_CATALOG=data/clean_runs/s2-full-v2/images.csv
RAG_IMAGES_DOCUMENTS=data/chunk_runs/s2-full-v1/documents.jsonl
RAG_IMAGES_ROOT=data/media/blobs
RAG_IMAGES_MANIFESTS=data/crawl_runs/s2-full-20261028/media
RAG_IMAGES_MAX_BYTES=20000000
RAG_IMAGES_MAX_PIXELS=40000000

# ---------- Dùng từ các sprint sau (bỏ dấu # khi tới lúc) ----------
# LLM_JUDGE_MODEL=deepseek-v4-pro
# [S4] Bảo vệ API
# ADMIN_TOKEN=change-me
# [S4] Tìm web dự phòng
# WEB_FALLBACK_ENABLED=true

# ---------- Offline ingest (TV2) ----------
# Contact sent in crawler User-Agent; required for network commands.
INGEST_CONTACT_EMAIL=
