# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- Chung ---
ENVIRONMENT=dev                # dev | prod
DOMAIN=localhost               # prod: tên miền thật, Caddy tự cấp HTTPS
DOCKER_LOG_DRIVER=none         # none: không ghi log container xuống đĩa · local: bật để debug

# --- PostgreSQL ---
POSTGRES_USER=indexbeast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=indexbeast
DATABASE_URL=postgresql+asyncpg://indexbeast:change-me@127.0.0.1:5432/indexbeast

# --- Qdrant / Redis ---
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0

# --- DeepSeek ---
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_JUDGE_MODEL=deepseek-v4-pro

# --- Bảo mật API ---
API_SERVICE_TOKEN=change-me    # bot gửi trong header X-Service-Token
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173

# --- RAG ---
WEB_FALLBACK_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# --- Discord bot ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=              # server test: đăng ký lệnh tức thì khi dev
BOT_API_URL=http://localhost:8000
WEB_URL=http://localhost:5173
