# Cấu hình Index Beast. Sao chép thành `.env` ở gốc repo rồi điền giá trị. KHÔNG commit file `.env`.
#
# Quy ước:
# - Chỉ có MỘT file .env, đặt ở gốc repo (backend, bot, docker compose đều đọc file này).
# - Chú thích đặt trên dòng riêng. KHÔNG viết `KEY=giá-trị  # chú thích`: docker compose sẽ hiểu
#   phần chú thích là giá trị khi giá trị để trống.
# - Dev local dùng 127.0.0.1 (không dùng localhost: Windows thử IPv6 trước nên bị timeout).
# - Trong Docker, địa chỉ PostgreSQL/Qdrant/Redis do docker-compose.yml đặt, bỏ qua giá trị ở đây.
# - Thêm biến mới: xem README → "Cấu hình".

# ---------- Chung ----------
# dev | test | prod. prod: app từ chối khởi động nếu còn giá trị "change-me"
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
# Dùng chung cho container postgres và backend (backend tự ghép thành connection URL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=indexbeast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=indexbeast

# ---------- Qdrant, Redis ----------
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0

# Giây chờ khi kết nối/đọc PostgreSQL, Qdrant, Redis; và tối đa cho mỗi health check
CLIENT_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2

# ---------- API ----------
# Cổng API khi chạy local (`make api`); web proxy /api và bot dev cũng đọc biến này.
# Trong Docker, API luôn nghe cổng 8000 nội bộ — biến này không ảnh hưởng.
API_PORT=8001
# Nhiều origin: phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
# Số worker uvicorn trong container api
API_WORKERS=2

# ---------- Discord bot ----------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Server Discord dùng khi dev: slash command được đăng ký ngay lập tức
DISCORD_GUILD_ID=
# Bot gửi token này trong header X-Service-Token khi gọi API
API_SERVICE_TOKEN=change-me
# Bỏ trống: bot dev gọi http://127.0.0.1:<API_PORT>. Trong Docker, compose đặt http://api:8000
BOT_API_URL=
WEB_URL=http://localhost:5173

# ---------- Triển khai ----------
# Tên miền thật trên VPS để Caddy tự cấp HTTPS
DOMAIN=localhost
# none: không ghi log container xuống đĩa · local: bật để debug (xoay vòng 5×20MB)
DOCKER_LOG_DRIVER=none

# ---------- DeepSeek Platform (TV3) ----------
# Key lấy từ DeepSeek Platform. Backend vẫn chạy health endpoint khi key để trống.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------- Dùng từ các sprint sau (bỏ dấu # khi tới lúc) ----------
# LLM_JUDGE_MODEL=deepseek-v4-pro
# [S4] Bảo vệ API
# ADMIN_TOKEN=change-me
# RATE_LIMIT_PER_MINUTE=10
# [S4] Tìm web dự phòng
# WEB_FALLBACK_ENABLED=true
