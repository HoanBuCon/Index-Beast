# DOMAIN=localhost khi chạy thử; đặt tên miền thật để Caddy tự cấp HTTPS
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1    # SSE: đẩy token về trình duyệt ngay, không đệm
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
