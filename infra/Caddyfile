# DOMAIN=localhost khi chạy thử; đặt tên miền thật để Caddy tự cấp HTTPS.
# Caddy là ngoại lệ của quy ước cổng: phải dùng 80/443 để trình duyệt và Let's Encrypt truy cập được.
# Phần proxy /api và web tĩnh dùng chung ở infra/caddy/snippets.caddy.
import /etc/caddy/snippets.caddy

{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		import api_proxy
	}

	handle {
		import spa
	}
}
