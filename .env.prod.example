# Mẫu .env cho VPS production (cp .env.prod.example .env rồi điền). KHÔNG commit .env; chạy: chmod 600 .env
# scripts/deploy.sh từ chối chạy nếu .env còn "change-me", thiếu biến bắt buộc hoặc quyền rộng hơn 600.
# Biến không liệt kê ở đây lấy mặc định của docker-compose.yml (ý nghĩa: xem .env.example).
# Đặt cứng trong docker-compose.prod.yml, KHÔNG có tác dụng khi đặt ở .env:
#   ENVIRONMENT=prod, CHAT_MODE=rag, CHAT_PERSISTENCE=postgres, CHAT_AGENT_ENABLED=true,
#   WEB_URL / CORS_ORIGINS / AUTH_REDIRECT_URI (suy ra từ DOMAIN), AUTH_COOKIE_SECURE=true.

# --- Tên miền ---
# DNS A của tên miền phải trỏ về IP VPS trước lần deploy đầu (Caddy cần xác thực Let's Encrypt qua cổng 80)
DOMAIN=tarnished.liemdai.io.vn

# --- Bắt buộc: sinh bằng `openssl rand -hex 32`, mỗi biến một giá trị riêng ---
# POSTGRES_PASSWORD chỉ có tác dụng khi volume pgdata được tạo lần đầu; đổi sau này phải ALTER ROLE trong PostgreSQL
POSTGRES_PASSWORD=change-me
API_SERVICE_TOKEN=change-me
ADMIN_TOKEN=change-me

# --- LLM và tìm web ---
DEEPSEEK_API_KEY=change-me
# Tùy chọn: tìm web dự phòng (WEB_SEARCH_ENABLED mặc định true; thiếu khóa thì bước này bị bỏ qua)
TAVILY_API_KEY=

# --- Đăng nhập Discord (ADR-005) ---
# Discord Developer Portal -> OAuth2: lấy Client ID/Secret, thêm vào mục Redirects đúng URL:
#   https://tarnished.liemdai.io.vn/api/v1/auth/discord/callback
# (đổi DOMAIN thì URL này đổi theo, và phải sửa cả trong Portal)
DISCORD_CLIENT_ID=change-me
DISCORD_CLIENT_SECRET=change-me
# Khóa băm Discord ID. KHÔNG đổi sau khi đã có người dùng (đổi là mất liên kết tài khoản)
AUTH_SECRET=change-me
# Discord ID (số) của quản trị viên, cách nhau bằng dấu phẩy: vào được /admin mà không cần ADMIN_TOKEN
AUTH_ADMIN_DISCORD_IDS=
AUTH_SESSION_DAYS=7

# --- Bot Discord (tùy chọn) ---
# Để trống DISCORD_TOKEN thì deploy.sh bỏ qua container bot
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# --- Hiệu năng và dữ liệu ---
# Hết RAM (OOM) thì giảm API_WORKERS=1 hoặc RAG_ENCODER_THREADS trước, đừng nâng giới hạn khi chưa đo
API_WORKERS=2
# Bật khi đã chép backend/data/media (~7,5 GB) lên VPS
RAG_IMAGES_ENABLED=false
# Collection Qdrant cho RAG; backup.sh chụp snapshot đúng collection api đang dùng. Mặc định theo docker-compose.yml
# RAG_COLLECTION=lore_chunks

# --- Log và backup ---
# local = xoay vòng 5x20 MB (xem bằng `docker compose logs`); none = không ghi log xuống đĩa
DOCKER_LOG_DRIVER=local
# Thư mục backup (NGOÀI repo, đường dẫn tuyệt đối) mặc định là $HOME/indexbeast-backups.
# Muốn đổi: đặt BACKUP_DIR=... ngay trong dòng crontab (scripts/backup.sh đọc biến môi trường, không đọc .env)
