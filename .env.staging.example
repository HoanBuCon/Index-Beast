# Mẫu .env cho VPS staging (cp .env.staging.example .env rồi điền). Không commit .env; chmod 600 .env.
# Ngoài các biến dưới đây, mọi biến khác lấy mặc định của docker-compose.yml (xem .env.example để biết ý nghĩa).

# --- Bắt buộc: ENVIRONMENT=prod từ chối khởi động nếu còn "change-me" ---
POSTGRES_PASSWORD=change-me
# Bot gọi API và web gọi /admin: tạo bằng `openssl rand -hex 32`
API_SERVICE_TOKEN=change-me
ADMIN_TOKEN=change-me
DEEPSEEK_API_KEY=

# --- Chạy RAG thật, lưu hội thoại và trace vào PostgreSQL (mặc định của compose staging, ghi lại cho rõ) ---
CHAT_MODE=rag
CHAT_PERSISTENCE=postgres

# --- Bảo vệ staging bằng Caddy ---
# IP của VPS khi chưa có tên miền (Caddy dùng chứng chỉ nội bộ, trình duyệt cảnh báo một lần).
# Có tên miền thì đặt tên miền, Caddy tự xin chứng chỉ Let's Encrypt (cần DNS trỏ về VPS, mở 80/443).
STAGING_HOST=
STAGING_USER=staging
# Băm bcrypt, KHÔNG phải mật khẩu. Tạo: docker run --rm caddy:2.11.7-alpine caddy hash-password
# Đặt trong dấu nháy đơn để Docker Compose không diễn giải ký tự $
STAGING_PASSWORD_HASH=''
# Tùy chọn: chỉ cho các IP này vào (cách nhau bằng dấu cách). Mặc định mọi IP, vẫn cần mật khẩu.
# STAGING_ALLOW_IPS=203.0.113.5 198.51.100.0/24

# --- Tùy chọn ---
# Ảnh minh họa cần chép backend/data/media (~7,5 GB) lên VPS; mặc định tắt
# RAG_IMAGES_ENABLED=false
# TAVILY_API_KEY=
# DISCORD_TOKEN=          # để trống thì deploy.sh bỏ qua container bot
